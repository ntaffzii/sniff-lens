{
  "manifest_version": 3,
  "name": "Network Image Sniffer & AI Toolkit",
  "version": "3.1.0",
  "description": "High-performance Network Layer media sniffer with Multi-Block Hardware Key Macro Studio, HLS Video Stitcher, Lightbox Preview, and batch downloader.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "tabs",
    "downloads",
    "storage",
    "webRequest",
    "declarativeNetRequest",
    "webNavigation",
    "sidePanel",
    "debugger"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Network Image Sniffer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
